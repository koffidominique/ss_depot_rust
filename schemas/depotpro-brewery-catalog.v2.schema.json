{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://depotpro.local/schemas/brewery-catalog.v2.schema.json",
  "title": "DEPOTPRO Brewery Catalog",
  "description": "Canonical producer reference catalog. Packaging values and bottle-return deposits are deliberately excluded. Only explicitly defined plastic crates are tracked as physical assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "producer",
    "catalogue",
    "categories",
    "brands",
    "products",
    "crate_types",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "country",
        "currency"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "legal_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": "string"
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "currency": {
          "const": "XOF"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "reference_date"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reference_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published",
            "archived"
          ]
        }
      }
    },
    "import_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "alcoholic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "alcoholic": {
            "type": "boolean"
          },
          "sort_order": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "official_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "evidence_status": {
            "enum": [
              "verified",
              "to_verify",
              "historical",
              "custom"
            ]
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "brand_id",
          "name",
          "category_id",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "brand_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category_id": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "official_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "catalog_status": {
            "enum": [
              "current",
              "historical",
              "discontinued",
              "to_verify"
            ]
          },
          "active_in_reference": {
            "type": "boolean"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sku",
                "display_name",
                "container",
                "evidence_status",
                "package_options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "sku": {
                  "type": "string",
                  "minLength": 1
                },
                "barcode": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1
                },
                "volume_ml": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "alcohol_by_volume_percent": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "container": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "material",
                    "reusable"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "bottle",
                        "can",
                        "carton",
                        "other"
                      ]
                    },
                    "material": {
                      "enum": [
                        "glass",
                        "pet",
                        "aluminium",
                        "cardboard",
                        "plastic",
                        "other"
                      ]
                    },
                    "reusable": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "package_options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unit_code",
                      "unit_name",
                      "units_per_package",
                      "base_unit",
                      "status"
                    ],
                    "properties": {
                      "unit_code": {
                        "enum": [
                          "unit",
                          "crate",
                          "carton",
                          "pack",
                          "case",
                          "other"
                        ]
                      },
                      "unit_name": {
                        "type": "string"
                      },
                      "units_per_package": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "base_unit": {
                        "const": "unit"
                      },
                      "status": {
                        "enum": [
                          "confirmed",
                          "to_verify",
                          "custom"
                        ]
                      },
                      "source_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "crate_compatibility": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "crate_type_id",
                      "status"
                    ],
                    "properties": {
                      "crate_type_id": {
                        "type": "string"
                      },
                      "bottles_per_crate": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "status": {
                        "enum": [
                          "confirmed",
                          "to_verify",
                          "rejected"
                        ]
                      },
                      "source_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "evidence_status": {
                  "enum": [
                    "verified",
                    "to_verify",
                    "historical",
                    "custom",
                    "inactive"
                  ]
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "crate_types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "name",
          "material",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "producer_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "material": {
            "const": "plastic"
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "compatible_variant_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "confirmed",
              "to_verify",
              "inactive"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "type",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "type": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
